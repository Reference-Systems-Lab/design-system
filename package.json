{
  "name": "design-system",
  "private": true,
  "description": "The commerce platform's design tokens, shared frontend configuration and, later, components",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:package": "turbo run check:package",
    "check": "turbo run build lint typecheck test check:package"
  },
  "devDependencies": {
    "turbo": "2.11.6"
  },
  "allowScripts": {}
}
