{
  "name": "design-system",
  "private": true,
  "description": "The commerce platform's design tokens, shared frontend configuration and, later, components",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:package": "turbo run check:package",
    "check": "turbo run build lint typecheck test check:package",
    "lint:root": "eslint *.js && prettier --check .",
    "fixture": "sh scripts/fixture.sh",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --no-audit --no-fund"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@reference-systems-lab/eslint-config": "*",
    "@reference-systems-lab/prettier-config": "*",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "publint": "0.3.25",
    "turbo": "2.11.6",
    "typescript": "6.0.3"
  },
  "allowScripts": {},
  "prettier": "@reference-systems-lab/prettier-config"
}
