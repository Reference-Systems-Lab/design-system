{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "100": {
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "200": {
        "$value": {
          "value": 0.875,
          "unit": "rem"
        }
      },
      "300": {
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "400": {
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "500": {
        "$value": {
          "value": 1.25,
          "unit": "rem"
        }
      },
      "600": {
        "$value": {
          "value": 1.5,
          "unit": "rem"
        }
      },
      "700": {
        "$value": {
          "value": 2,
          "unit": "rem"
        }
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "bold": {
        "$value": 700
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.25
      },
      "normal": {
        "$value": 1.5
      }
    }
  }
}