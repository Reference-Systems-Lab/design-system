{
  "name": "@reference-systems-lab/tsconfig",
  "version": "0.0.0",
  "description": "Shared TypeScript presets: base, vue-app and library, all strict",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reference-Systems-Lab/design-system.git",
    "directory": "packages/tsconfig"
  },
  "type": "module",
  "exports": {
    "./base.json": "./base.json",
    "./vue-app.json": "./vue-app.json",
    "./library.json": "./library.json",
    "./package.json": "./package.json"
  },
  "files": [
    "base.json",
    "vue-app.json",
    "library.json"
  ],
  "scripts": {
    "lint": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "check:package": "publint --strict --pack npm"
  },
  "peerDependencies": {
    "typescript": "~6.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
