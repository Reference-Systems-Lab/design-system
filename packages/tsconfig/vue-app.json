{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Vue app: the base, with the DOM, Vue's JSX handling and strict templates",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "vue"
  },
  "vueCompilerOptions": {
    "strictTemplates": true,
    "dataAttributes": ["data-*"]
  }
}
