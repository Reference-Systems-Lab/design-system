{
  "name": "@reference-systems-lab/eslint-config",
  "version": "0.0.0",
  "description": "The shared ESLint flat config: typescript-eslint type-checked, Vue and accessibility rules",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reference-Systems-Lab/design-system.git",
    "directory": "packages/eslint-config"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "check:package": "publint --strict --pack npm"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": "~6.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
