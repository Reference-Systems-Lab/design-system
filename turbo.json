{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.js",
        "$TURBO_ROOT$/.prettierignore",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/packages/eslint-config/index.js",
        "$TURBO_ROOT$/packages/prettier-config/index.js"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "check:package": {
      "dependsOn": ["build"]
    }
  }
}
